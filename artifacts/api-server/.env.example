# ============================================================
# Pindrop — API Server Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# Never commit your actual .env file to version control.
# ============================================================

# ── Server ──────────────────────────────────────────────────
# Port the Express server listens on.
# Default: 5000 (local development)
PORT=5000

# Node environment: development | production | test
NODE_ENV=development

# ── CORS ────────────────────────────────────────────────────
# The exact origin of the frontend application.
# In production: required — must match your deployed frontend URL exactly.
# In development: leave unset; localhost origins are allowed automatically.
# Example: https://pindrop.app
FRONTEND_ORIGIN=

# ── Logging ─────────────────────────────────────────────────
# Pino log level: trace | debug | info | warn | error | fatal
# Default: info
LOG_LEVEL=info

# ── Download limits ─────────────────────────────────────────
# Maximum video file size (bytes) that Pindrop will stream.
# Default: 52428800 (50 MB)
MAX_DOWNLOAD_SIZE=52428800

# ── Rate limiting ───────────────────────────────────────────
# These are currently in-memory defaults (no Redis).
# RATE_LIMIT_MAX and RATE_LIMIT_WINDOW_MS can be adjusted
# in routes/pinterest.ts directly for now.
# Future: expose as env vars if needed.
