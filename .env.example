# ============================================================
# Pindrop — Vercel Environment Variables (template)
# ============================================================
# Copy the values you need into your Vercel project:
#   Settings → Environment Variables.
# Never commit your real .env file. This file only documents
# which variables the app reads and what they are for.
# ============================================================

# ── Build-time (applies to the Vite frontend build) ──────────
# Canonical HTTPS site origin, baked into <link rel=canonical>,
# Open Graph tags and JSON-LD. Must match the deployed origin.
# Update public/robots.txt and public/sitemap.xml to the same
# value when the origin changes.
# VITE_SITE_URL=https://pins26.vercel.app

# Optional contact email displayed on /contact.
# VITE_CONTACT_EMAIL=hello@pindrop.app

# Used only by the local Vite dev proxy; production browser
# traffic uses the same-origin /api path.
# VITE_API_BASE_URL=http://localhost:5000

# ── Runtime (API Function) ────────────────────────────────────
# CORS allow-origin for browser cross-origin requests.
# Same-origin deployments (frontend + /api on one origin) do
# NOT need this; leave it empty on Vercel. Required only when
# the frontend is served from a different origin than the API.
# FRONTEND_ORIGIN=

# Pino log level: trace | debug | info | warn | error | fatal
# LOG_LEVEL=info

# Maximum video size (bytes) the API will relay.
# Default 52428800 (50 MB) exceeds Vercel's ~4.5 MB Function
# response ceiling; keep compatible with the Vercel limit.
# MAX_DOWNLOAD_SIZE=52428800

# Resolve requests allowed per IP per 60 s window (per instance).
# RATE_LIMIT=10

# Upstream timeout (ms) for Pinterest page/probe/download calls.
# REQUEST_TIMEOUT_MS=15000

# ── Automatic (do not set manually) ───────────────────────────
# NODE_ENV     → set to "production" by Vercel at runtime
# VERCEL       → set by Vercel; enables Express "trust proxy"
# PORT         → local-only listener, ignored on Vercel