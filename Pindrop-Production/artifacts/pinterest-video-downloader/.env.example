# ============================================================
# Pindrop — Frontend Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# Never commit your actual .env file to version control.
# Variables prefixed VITE_ are exposed to the browser bundle.
# ============================================================

# ── API connection ──────────────────────────────────────────
# Base URL of the API server.
# In development: leave unset — Vite proxy to http://localhost:5000 is used.
# In production: set to your deployed API URL (same origin as frontend if proxied,
#                or the full URL if using a separate backend domain).
# Example: https://api.pindrop.app
VITE_API_BASE_URL=http://localhost:5000

# ── Contact ─────────────────────────────────────────────────
# Email address shown on the /contact page.
# If not set, the contact page shows a placeholder.
VITE_CONTACT_EMAIL=hello@pindrop.app

# ── SEO ─────────────────────────────────────────────────────
# The canonical site URL used in structured data and sitemap.
# Update src/lib/seo.ts with your final domain before going live.
# SITE_URL=https://pindrop.app  (configured in src/lib/seo.ts directly)
