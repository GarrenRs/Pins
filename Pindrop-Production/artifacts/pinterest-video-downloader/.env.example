# Pindrop frontend environment variables
# Copy to .env for local work. Do not commit .env files.

# Used only by Vite's local development proxy; the browser client uses the
# same-origin /api path in production. Default: http://localhost:5000
VITE_API_BASE_URL=http://localhost:5000

# Optional contact address displayed on /contact.
VITE_CONTACT_EMAIL=hello@example.com

# Required for production: canonical HTTPS origin embedded in page metadata.
# Update public/robots.txt and public/sitemap.xml to use the exact same origin.
VITE_SITE_URL=https://example.com
